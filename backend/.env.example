# Copier en .env, ou exporter ces variables avant de lancer uvicorn.

# --- Implémentations : "stub" pour développer sans GPU ni clé -----------------
KOUMA_TRANSLATOR=stub            # stub | nllb
KOUMA_LLM=stub                   # stub | gemini | openrouter

# --- Traducteur NLLB (si KOUMA_TRANSLATOR=nllb) ------------------------------
# --- Option A (recommandée depuis le 12/10) : modèle FUSIONNÉ de Syndoux -----------
# Un seul modèle complet (~2,6 Go), aucun adaptateur, peft inutile.
# Révision figée = version validée avec max_length=64 (commit 5c36e48).
KOUMA_NLLB_BASE_MODEL=syndou/nllb-200-dioula
KOUMA_NLLB_REVISION=5c36e481ce9ce8d6f73a57181fb93d6900ddad89
KOUMA_ADAPTER_FRA_DYU=
KOUMA_ADAPTER_DYU_FRA=

# --- Option B : NLLB de base + adaptateurs LoRA (alternative légère) ------------------
# KOUMA_NLLB_BASE_MODEL=facebook/nllb-200-1.3B
# KOUMA_NLLB_REVISION=
# KOUMA_ADAPTER_FRA_DYU=models/nllb_lora_dioula_v2
# KOUMA_ADAPTER_DYU_FRA=models/nllb_lora_dioula_v2
#   hf download syndou/nllb-lora-dioula --revision 5aff243 --local-dir models/nllb_lora_dioula_v2
KOUMA_DEVICE=auto                # auto | cuda | mps | cpu
KOUMA_NUM_BEAMS=4
KOUMA_MAX_NEW_TOKENS=128
KOUMA_NO_REPEAT_NGRAM_SIZE=3
KOUMA_MAX_CONCURRENT_TRANSLATIONS=2

# --- LLM ---------------------------------------------------------------------
# Paquets : pip install -r requirements-model.txt (google-genai et openai).
KOUMA_LLM_MAX_TOKENS=1000        # 1000 mini pour les modèles à raisonnement (GPT-5 Mini)
KOUMA_LLM_TIMEOUT_SECONDS=60

# Si KOUMA_LLM=openrouter (modèle retenu par le benchmark du 08/10)
OPENROUTER_API_KEY=
KOUMA_OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Si KOUMA_LLM=gemini
GEMINI_API_KEY=
KOUMA_GEMINI_MODEL=gemini-2.5-flash

# --- Langues et conversation -------------------------------------------------
KOUMA_ENABLED_LANGUAGES=dyu      # ex. dyu,bam
KOUMA_HISTORY_MAX_TURNS=6
KOUMA_SESSION_TTL_SECONDS=1800
KOUMA_MAX_MESSAGE_CHARS=1000

# --- Sécurité ----------------------------------------------------------------
KOUMA_AUTH_ENABLED=true
KOUMA_API_KEYS_DB=data_runtime/api_keys.sqlite3
KOUMA_RATE_LIMIT_PER_MINUTE=30
KOUMA_CORS_ORIGINS=              # ex. http://localhost:3000,https://appli.exemple
KOUMA_DEBUG_ALLOWED=false        # true en dev pour voir fr_input/fr_reply/timings
